# ── FloraAI Environment Configuration ─────────────────────────────────────────
#
# Copy this file to .env and configure your local environment settings.
# Never commit your real .env file with secrets to version control.
#
# ── Google Gemini AI Assistant ────────────────────────────────────────────────
# Used for contextual agronomist chat assistant and build-time Indic translation.
# Get your free API key from: https://aistudio.google.com/app/apikey
# Note: The application operates gracefully without this key (uses agronomic rule-based fallbacks).
GEMINI_API_KEY=your_gemini_api_key_here

# ── Application Environment & Networking ──────────────────────────────────────
FLORA_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=5173

# ── PyTorch Hardware Acceleration ─────────────────────────────────────────────
# Set to 'cuda' if NVIDIA GPU with CUDA 12.x is available, or 'cpu' for standard runner.
DEVICE=cpu
